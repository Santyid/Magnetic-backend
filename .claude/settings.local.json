{
  "permissions": {
    "allow": [
      "Bash(node --version:*)",
      "Bash(npm --version:*)",
      "Bash(npm init:*)",
      "Bash(npm install:*)",
      "Bash(npm run build:*)",
      "Bash(tree:*)",
      "Bash(npm create:*)",
      "Bash(npm uninstall:*)",
      "Bash(pkill:*)",
      "Bash(curl:*)",
      "Bash(export NVM_DIR=\"$HOME/.nvm\")",
      "Bash([ -s \"$NVM_DIR/nvm.sh\" ])",
      "Bash(. \"$NVM_DIR/nvm.sh\")",
      "Bash(nvm use:*)",
      "Bash(npx jest --forceExit --detectOpenHandles)"
    ]
  }
}
